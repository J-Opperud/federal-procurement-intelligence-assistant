
# Generate a unique secret of at least 32 characters for local use.
JWT_SECRET_KEY=replace-this-with-your-own-random-secret-of-32-characters
# Optional: defaults to the local SQLite database.
# DATABASE_URL=sqlite:///./data/scout.db
# Required: SAM.gov API key for official procurement synchronization.
SAM_API_KEY=replace-with-your-sam-gov-api-key